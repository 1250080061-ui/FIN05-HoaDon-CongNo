        <mxCell id="a0" value="1. Chọn hóa đơn; mở tạo điều chỉnh công nợ" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#6FC8EB;strokeColor=#36454F;strokeWidth=1.2;fontColor=#000000;fontSize=14;fontFamily=Arial;spacing=8;" vertex="1" parent="user">
