{
  "realm": "fin05",
  "enabled": true,
  "displayName": "FIN05 · Hóa đơn và công nợ phải thu",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "roles": { "realm": [
    { "name": "admin", "description": "Quản trị viên" },
    { "name": "sales", "description": "Nhân viên kinh doanh" },
    { "name": "accountant", "description": "Kế toán công nợ" },
    { "name": "cashier", "description": "Nhân viên thu tiền" },
    { "name": "manager", "description": "Ban quản lý" }
  ] },
  "clients": [
    {
      "clientId": "fin05-web", "name": "FIN05 Web", "enabled": true,
      "publicClient": true, "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false, "implicitFlowEnabled": false,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "http://localhost:5173/*" },
      "protocolMappers": [
        { "name": "fin05-api-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": { "included.client.audience": "fin05-api", "access.token.claim": "true", "id.token.claim": "false" } },
        { "name": "fin05-roles", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-realm-role-mapper", "config": { "claim.name": "roles", "jsonType.label": "String", "multivalued": "true", "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false" } }
      ]
    },
    { "clientId": "fin05-api", "name": "FIN05 API", "enabled": true, "bearerOnly": true }
  ]
}
